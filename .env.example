# Access codes for the two gated roles. Copy this file to .env.local and change
# every value. Without .env.local the fallbacks in src/lib/auth.ts are used,
# which are readable by anyone with the repo.
#
# On Vercel, set the same three keys in Project Settings -> Environment Variables.

# Unlocks /auctioneer (the live bidding console).
AUCTIONEER_CODE=

# Unlocks /admin, and everything the auctioneer can reach.
ADMIN_CODE=

# Signs the session cookie. Any long random string; changing it logs everyone out.
AUCTION_SECRET=
